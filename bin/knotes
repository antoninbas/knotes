#!/usr/bin/env bash
# Wrapper script for knotes CLI.
# Sets KNOTES_BIN to its own resolved path so `knotes service install` can
# identify the correct binary without relying on `which` or hardcoded paths.

# Resolve symlinks to find the actual wrapper path
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
PACKAGE_DIR="$(dirname "$SCRIPT_DIR")"

export KNOTES_BIN="$SCRIPT"
exec node "$PACKAGE_DIR/dist/main.js" "$@"
