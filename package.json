{
  "name": "@antoninbas/knotes",
  "version": "0.4.0",
  "description": "A local-first note and activity log manager with hybrid search",
  "type": "module",
  "bin": {
    "knotes": "bin/knotes.mjs"
  },
  "scripts": {
    "dev": "npx tsx src/main.ts",
    "dev:web": "npx tsx src/main.ts web",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "!src/web/app/node_modules",
    "!src/web/app/src",
    "!src/web/app/*.ts",
    "!src/web/app/*.json",
    "!src/web/app/*.css",
    "!src/web/app/*.html"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^22",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@modelcontextprotocol/sdk": "^1",
    "@tobilu/qmd": "^2.1.0",
    "better-sqlite3": "^11",
    "commander": "^13",
    "gray-matter": "^4",
    "hono": "^4",
    "tsx": "^4",
    "zod": "^3"
  }
}
